# Port the web server listens on (if left empty and 3000 is busy, the next free port is used)
PORT=
# SQLite database file (created automatically, seeded with demo data on first run)
DB_PATH=./data/store.db
# Optional: enables the Claude-powered assistant. Without it the bot falls back to FAQ keyword matching.
ANTHROPIC_API_KEY=

# ----- Email (SMTP) -----
# Leave SMTP_HOST empty to only record emails in the admin Emails tab (nothing is delivered).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false for 587/25 (STARTTLS is used automatically when offered)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Merch Store <merch@yourcompany.com>"

# Used in email text and links
COMPANY_NAME=Company
APP_URL=http://localhost:3000

# Collection days are calendar dates in this timezone; reminders go out from REMINDER_HOUR
# (24h clock, local time) on the day before collection. Empty APP_TIMEZONE = this computer's timezone,
# or set one like Asia/Kuala_Lumpur, Asia/Singapore, Europe/London.
APP_TIMEZONE=
REMINDER_HOUR=9
